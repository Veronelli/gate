# Endpoint del catálogo de productos (server-side, lo usa /api/productos).
# Soporta el placeholder {q} para el término de búsqueda; si no está, se
# agrega ?query=<termino> al final de la URL.
CATALOG_API_URL=https://example.com/api/product-search?query={q}

# Máximo de compras históricas en las que se basa la estimación de consumo.
NEXT_PUBLIC_CONSUMPTION_HISTORY_MAX=3

# --- Recordatorios por Telegram ---
# Token del bot (server-side; lo usa el webhook y el cron). Nunca NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=
# Secret que Telegram manda en el header X-Telegram-Bot-Api-Secret-Token
# (se define al registrar el webhook con setWebhook).
TELEGRAM_WEBHOOK_SECRET=
# Username público del bot, para armar el link "Vincular Telegram" en la UI.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# URL pública de la app (para los botones "Ver lista" de los mensajes).
APP_URL=https://tu-app.example.com
# Secret del endpoint fallback /api/cron/reminders (scheduler externo).
CRON_SECRET=

# --- Checky: agente de Telegram (LangChain + Hugging Face) ---
# Token de Hugging Face (Inference Providers). Solo Telegram lo usa.
HF_API_TOKEN=
# Modelo del router de HF (OpenAI-compatible, con soporte de tools).
HF_MODEL=meta-llama/Llama-3.3-70B-Instruct
# Máximo de mensajes de usuario por día (UTC). Default 7.
CHECKY_DAILY_INPUT_MAX=7
# Ventana de contexto: últimas N interacciones (pares user+assistant). Default 14.
CHECKY_CONTEXT_MAX=14
